#!/bin/sh
# pre-commit (PRD 1814): the fallow audit of the work tree being committed, run by
# scripts/check-changed-hooks.ts. `pnpm install` turns the hooks on (scripts/install-hooks.ts).
# It fails closed: a tool it cannot find, or an audit that cannot run, refuses the commit. The
# emergency hatch is `git commit --no-verify`, and the pull request says why it was used.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found on PATH: install Node >= 22.18, then run pnpm install" >&2
  exit 1
fi
exec node "$(dirname "$0")/../scripts/check-changed.ts" --hook pre-commit
