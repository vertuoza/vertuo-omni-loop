# Leave both empty to run on the built-in demo galaxy.
# `supabase start` prints these for the local stack (API URL and anon key). For a hosted project,
# the anon key may be the publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for `pnpm galaxy:sync` (writes the ledger into Supabase). Never expose it to the browser.
# For a hosted project: the secret key (sb_secret_…) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
