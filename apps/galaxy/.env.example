# Every variable the arcade reads is listed here, and each one is optional: with nothing set, development
# serves the demo galaxy and a production build the closed mode. A group set halfway (a URL without its
# key, an App id without its private key) or a malformed value (a URL that is not one) stops the server
# at startup with one error naming the variables (src/env.ts, PRD 1059): set all of a group, or none.

# Leave both empty to run on the built-in demo galaxy; set both, or neither.
# `supabase start` prints these for the local stack (API URL http://127.0.0.1:54321, and the anon key).
# For a hosted project, the anon key may be the publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a build without Supabase serves the demo galaxy when this is 1, instead of the closed mode.
OMNI_LOOP_DEMO=

# Server only; never expose it to the browser. The sign-in callbacks use it to join a person to the
# workspaces of their GitHub orgs, and sign-up to make a workspace from an installation and keep
# sign-up requests (PRD 359); the `pnpm game:*` commands use it to read and append the ledger. Left
# empty, sign-in still works but nobody joins a workspace, and sign-up shows its error screen.
# For a hosted project: the secret key (sb_secret_…) or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, with the service role's key: the database's address as the service role reads it, when it is
# not the public one. The season cache falls back on NEXT_PUBLIC_SUPABASE_URL; `pnpm releases:sync`
# needs it.
SUPABASE_URL=

# The omni-loop GitHub App (apps/omni-app/app.yml), for sign-up at /signup (PRD 359). Server only:
# never give them a NEXT_PUBLIC_ name. From the App's settings page on GitHub: its App ID, its public
# slug (github.com/apps/<slug>), and a private key it generated (the whole .pem; on one line, write
# each line break as \n). Left empty, /signup says sign-up is not open here.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# The same App's OAuth client, for Send on a PRD's Outbox tab (PRD 251): the person authorises the App
# once, and their answers are posted on the feature pull request as them. Server only: never give them
# a NEXT_PUBLIC_ name. From the App's settings page: its Client ID, and a client secret it generated.
# The App's callback URL must include <this site>/prd/github/callback. Left empty, the tab reads the
# questions and says sending is not open here.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional: sorts each ask question into one of six categories, through OpenRouter, after it is asked.
# Server only; never expose it to the browser. Left empty, questions stay unsorted and nothing fails.
OPENROUTER_API_KEY=

# Real PRD stages (PRD 587). Server only; never give them a NEXT_PUBLIC_ name. Each is a long random
# string (`openssl rand -hex 32`).
# - STAGES_SYNC_SECRET: the bearer the `stages` workflow sends to POST /api/stages/sync every 15
#   minutes. The same value goes in the repository's Actions secrets. Left empty, the sync is refused
#   (401) and no stage is recorded by it.
# - STAGE_EVENT_SECRET: signs the stage events omni-app sends to POST /api/stages/event when a PR is
#   merged, marked ready or opened. The same value goes on omni-app. Left empty, events are refused
#   (401) and stages wait for the next sync.
STAGES_SYNC_SECRET=
STAGE_EVENT_SECRET=

# Jev decisions (PRD 812). Server only; never give it a NEXT_PUBLIC_ name. The master key that encrypts
# each workspace's TypeSafe API key (AES-256-GCM) before it is stored: 32 random bytes, base64
# (`openssl rand -base64 32`). Left empty (or not 32 bytes), Settings › Jev says Jev is not available on
# this deployment, no key can be saved, and every decision is made as before. Losing it makes the stored
# keys unreadable: each owner then pastes their key again.
SECRETS_MASTER_KEY=

# The constituent judge (PRD 871) and the weekly business recheck (PRD 774). Server only; never give them
# a NEXT_PUBLIC_ name. Each is a long random string (`openssl rand -hex 32`).
# - CONSTITUENT_JUDGE_SECRET: the bearer omni-app sends to the judge; the same value goes on omni-app.
#   Left empty, every call is refused and the decision is made as before.
# - BUSINESS_RECHECK_SECRET: the bearer the recheck workflow sends. Left empty, the recheck is refused.
CONSTITUENT_JUDGE_SECRET=
BUSINESS_RECHECK_SECRET=

# Optional, for `pnpm shots` only (scripts/shots.ts): the arcade it takes its screenshots of. Left empty,
# http://localhost:3000/.
GALAXY_URL=
