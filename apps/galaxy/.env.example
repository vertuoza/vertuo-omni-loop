# Leave both empty to run on the built-in demo galaxy.
# `supabase start` prints these for the local stack (API URL and anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for `pnpm galaxy:sync` (writes the ledger into Supabase). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
