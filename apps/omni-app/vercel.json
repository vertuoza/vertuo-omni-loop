{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --prod --filter @omni/omni-app...",
  "ignoreCommand": "cd ../.. && bash scripts/vercel-ignore.sh omni-app",
  "functions": {
    "api/github.mjs": {
      "maxDuration": 60
    },
    "api/inngest.mjs": {
      "maxDuration": 300
    },
    "api/server-event.mjs": {
      "maxDuration": 60
    }
  }
}
