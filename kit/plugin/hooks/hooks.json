{
  "description": "Ask mode: while it is on in a checkout, AskUserQuestion is answered on a web page, a tab per terminal. Silent otherwise. The heartbeat: after any tool call, at most once a minute, the Omni page learns this session is working; silent when signed out or with dossiers off.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.omni-loop/bin/omni.mjs\" ask hook pre || true",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.omni-loop/bin/omni.mjs\" ask hook post || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.omni-loop/bin/omni.mjs\" heartbeat || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.omni-loop/bin/omni.mjs\" ask hook prompt || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.omni-loop/bin/omni.mjs\" ask hook end || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.omni-loop/bin/omni.mjs\" heartbeat --end || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
