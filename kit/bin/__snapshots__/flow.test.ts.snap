// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`omni flow show <point> > prints a slice's hooks as text, each with its text 1`] = `
"point    do-work.test
areas    kernel
territory src/kernel/Bus/
replace  .omni-loop/flow/kernel/tests.md  (kernel)
after    .omni-loop/flow/contract-tests.md  (default)
kitStep: replaced
verdict  omni-hook do-work.test: pass | omni-hook do-work.test: fail <why>

## replace .omni-loop/flow/kernel/tests.md (kernel)
Run phpunit on src/kernel/Bus/ only.

## after .omni-loop/flow/contract-tests.md (default)
Run the contract tests of slice s1.
"
`;

