exports[`omni flow show > prints each difference from the kit's defaults, area by area (spec acceptance 5) 1`] = `
"flow — what this repository changes from the kit's defaults

default  every path no area claims
  rule  slice maxFiles 15
  rule  requireChecks phpunit
  hook  do-work.test after .omni-loop/flow/contract-tests.md
  hook  pr.open replace .omni-loop/flow/open-pr.md

kernel  ^src/kernel/
  rule  slice alone
  rule  slice maxFiles 5
  rule  wave first
  rule  blocks all
  rule  requireChecks phpunit, phpstan-max
  rule  approval person
  hook  do-work.test replace .omni-loop/flow/kernel/tests.md
  hook  do-work.test after .omni-loop/flow/contract-tests.md
  hook  pr.open replace .omni-loop/flow/open-pr.md
  hook  plan.slice before .omni-loop/flow/kernel/plan.md

migrations  ^database/migrations/
  rule  slice alone
  rule  slice maxFiles 1
  rule  landing alone
  rule  requireChecks phpunit
  hook  do-work.test after .omni-loop/flow/contract-tests.md
  hook  pr.open replace .omni-loop/flow/open-pr.md
"
`;

exports[`omni flow show --path > prints a kernel path's area, rules and hooks (spec acceptance 4) 1`] = `
"path     src/kernel/Bus/Dispatcher.php
area     kernel  ^src/kernel/
knowledge kernel
rules    slice alone · slice maxFiles 5 · wave first · blocks all · requireChecks phpunit, phpstan-max · approval person
hook     do-work.test replace .omni-loop/flow/kernel/tests.md
hook     do-work.test after .omni-loop/flow/contract-tests.md
hook     pr.open replace .omni-loop/flow/open-pr.md
hook     plan.slice before .omni-loop/flow/kernel/plan.md
"
`;
