{
  "storyboard": 1,
  "meta": {
    "fps": 30,
    "width": 1920,
    "height": 1080,
    "transition": 0.5,
    "music": { "sync": { "scene": 1, "at": 1 } },
    "sources": ["spec.md", "release-note.md"]
  },
  "scenes": [
    { "type": "intro", "duration": 2.5, "eyebrow": "New in Widgets", "title": "Quotes that send themselves", "tag": "PRD 7" },
    {
      "type": "feature",
      "duration": 3,
      "title": "Send from the quote",
      "layout": "left",
      "bullets": ["One click to send", "Signed online"],
      "media": {
        "kind": "clip",
        "file": "clips/walk.webm",
        "start": 0.5,
        "end": 3.5,
        "device": "browser",
        "camera": [{ "at": 0, "zoom": 1, "focus": { "x": 0.5, "y": 0.5 } }, { "at": 1.5, "zoom": 1.8, "focus": { "x": 0.6, "y": 0.4 } }],
        "callouts": [{ "at": 1.5, "until": 2.8, "kind": "ring", "box": { "x": 0.5, "y": 0.3, "w": 0.2, "h": 0.15 }, "label": "Send" }],
        "cursor": [{ "at": 0.5, "x": 0.4, "y": 0.5 }, { "at": 1.4, "x": 0.6, "y": 0.38, "click": true }]
      }
    },
    {
      "type": "beforeAfter",
      "duration": 2.5,
      "before": { "kind": "screenshot", "file": "shots/before.png" },
      "after": { "kind": "screenshot", "file": "shots/after.png" },
      "labels": { "before": "Before", "after": "Now" }
    },
    { "type": "outro", "duration": 2.5, "cta": "Available now", "closing": "Every quote, on its way.", "credits": true }
  ]
}
