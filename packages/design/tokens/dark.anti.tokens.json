{
  "$description": "The anti-loop mode over dark (Rewind Light): magenta takes the signal, the highlight takes yellow; only the roles it remaps.",
  "color": {
    "$type": "color",
    "border-subtle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2902,
          0.1098,
          0.4
        ],
        "hex": "#4a1c66"
      }
    },
    "border-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.7529,
          0.3529,
          0.6588
        ],
        "hex": "#c05aa8"
      }
    },
    "signal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.3725,
          0.7059
        ],
        "hex": "#ff5fb4"
      }
    },
    "signal-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2275,
          0.0863,
          0.3137
        ],
        "hex": "#3a1650"
      }
    },
    "text-on-signal": {
      "$value": "{deep}"
    },
    "highlight": {
      "$value": "{yellow}"
    },
    "text-on-highlight": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2275,
          0.1725,
          0
        ],
        "hex": "#3a2c00"
      }
    }
  }
}
