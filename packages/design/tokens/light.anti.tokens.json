{
  "$description": "The anti-loop mode over light (Rewind Light): magenta takes the signal, the highlight takes yellow; only the roles it remaps.",
  "color": {
    "$type": "color",
    "border-subtle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9255,
          0.8275,
          0.8941
        ],
        "hex": "#ecd3e4"
      }
    },
    "border-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6275,
          0.3333,
          0.5608
        ],
        "hex": "#a0558f"
      }
    },
    "signal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6902,
          0.0706,
          0.4784
        ],
        "hex": "#b0127a"
      }
    },
    "signal-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9843,
          0.8902,
          0.949
        ],
        "hex": "#fbe3f2"
      }
    },
    "text-on-signal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "highlight": {
      "$value": "{yellow}"
    },
    "text-on-highlight": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2275,
          0.1725,
          0
        ],
        "hex": "#3a2c00"
      }
    }
  }
}
