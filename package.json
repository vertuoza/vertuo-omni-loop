{
  "name": "vertuo-omni-plan",
  "private": true,
  "type": "module",
  "bin": {
    "omni": "kit/dist/omni.mjs"
  },
  "files": [
    "kit/dist/omni.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "game:project": "node --env-file-if-exists=apps/galaxy/.env.local game/cli/project.mjs",
    "game:score": "node --env-file-if-exists=apps/galaxy/.env.local game/cli/score.mjs",
    "game:banner": "node --env-file-if-exists=apps/galaxy/.env.local game/cli/banner.mjs",
    "game:export": "node --env-file-if-exists=apps/galaxy/.env.local game/cli/export.mjs",
    "kit:build": "node kit/build.mjs",
    "galaxy:dev": "pnpm --filter @omni/galaxy-app dev",
    "galaxy:build": "pnpm --filter @omni/galaxy-app build",
    "galaxy:artifact": "pnpm --filter @omni/galaxy-app artifact",
    "galaxy:seed": "pnpm --filter @omni/galaxy-app seed"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "vitest": "^2.1.0"
  }
}
